	["UI/Warning/Warning Black"] = "rbxassetid://101183755916944",
	["UI/Warning/Warning White"] = "rbxassetid://94600231328681",
	["UI/X/X 1st"] = "rbxassetid://77826851611585",
	["UI/X/X 1st Outline"] = "rbxassetid://95601809727413",
	["UI/X/X 2nd"] = "rbxassetid://81668618637137",
	["UI/X/X 2nd Outline"] = "rbxassetid://123776581110099",
	["UI/X/X Black"] = "rbxassetid://87032097259557",
	["UI/X/X White"] = "rbxassetid://74385637104908",
}
CheckUIIcons.FlatMap = FlatMap

--[[
	Get an icon asset ID by path or category, subcategory, itemName.
	Examples:
		CheckUIIcons.Get("Currency/Coin/Golden Coin 1st")
		CheckUIIcons.Get("Currency", "Coin", "Golden_1st")
--]]
function CheckUIIcons.Get(...: string): string
	local args = { ... }
	if #args == 1 then
		local path = args[1]
		if FlatMap[path] then
			return FlatMap[path]
		end
		-- Check direct lookup
		for k, v in pairs(FlatMap) do
			if string.find(string.lower(k), string.lower(path)) then
				return v
			end
		end
		warn("[CheckUIIcons] Icon not found for path: " .. tostring(path))
		return ""
	elseif #args == 3 then
		local cat, sub, name = args[1], args[2], args[3]
		local catTbl = CheckUIIcons[cat]
		if catTbl and catTbl[sub] and catTbl[sub][name] then
			return catTbl[sub][name]
		end
		warn("[CheckUIIcons] Icon not found for: " .. cat .. "." .. sub .. "." .. name)
		return ""
	end
	return ""
end

--[[
	Search icons by name keyword.
	Returns array of { Path = string, AssetId = string }
--]]
function CheckUIIcons.Search(keyword: string): { { Path: string, AssetId: string } }
	local results = {}
	local lower = string.lower(keyword)
	for path, assetId in pairs(FlatMap) do
		if string.find(string.lower(path), lower) then
			table.insert(results, { Path = path, AssetId = assetId })
		end
	end
	return results
end

return table.freeze(CheckUIIcons)